# Copy to .env and fill in. Do NOT commit .env (it holds secrets).

# Public domain for the phishing server (DNS A record -> this server's IP).
# Phishing links, tracking, and the LINE webhook are served here over HTTPS.
PHISH_DOMAIN=phish.example.com

# Shown on the transparency endpoint so recipients can identify the sender.
CONTACT_ADDRESS=security-team@example.com

# AI pretext generator (optional). Leave blank to disable the feature.
# base_url is the full endpoint (OpenAI-compatible ".../chat/completions"
# or Anthropic ".../v1/messages"). provider is "openai" (default) or "anthropic".
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER=openai
